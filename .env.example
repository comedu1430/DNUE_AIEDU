# Notion CMS setup
# 1. Create a Notion integration and paste its Internal Integration Secret here.
NOTION_TOKEN=

# 2. Paste the Notion page ID where the CMS page should be created.
NOTION_PARENT_PAGE_ID=

# 3. These are printed after running `npm run notion:create`.
NOTION_STUDENTS_DATABASE_ID=
NOTION_PUBLICATIONS_DATABASE_ID=
